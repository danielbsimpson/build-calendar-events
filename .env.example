# Copy this file to `.env` and fill in your secrets.
# Environment variables override matching values in config.yaml.

# --- SMTP credentials (used to send the calendar invites) ---
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password

# --- Optional overrides (otherwise taken from config.yaml) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_TO=you@example.com
# EMAIL_FROM=you@example.com
